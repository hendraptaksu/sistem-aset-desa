# Contoh konfigurasi dev — salin ke `.env` lalu sesuaikan.
# Hanya dibaca saat `npm run dev` (app production selalu pakai userData/data/pura.db).
# Path relatif dibaca dari root repo. Folder `data/` sudah di-gitignore.

PURA_DB=./data/pura-dev.db

# Seeder dev: isi DB kosong dengan 240 transaksi dummy (uji laporan multi-halaman).
# Hanya dibaca saat `npm run dev` + hanya jalan bila tabel transaksi masih kosong
# (tidak pernah menimpa data). Seed ulang = hapus file .db lalu restart.
PURA_SEED_DEV=false

# Kode darurat reset PIN (fitur Kunci Aplikasi). Default di src/main/kunci.ts:
# PURI-DARURAT-1945 — GANTI sebelum distribusi + catat di dokumen fisik bendahara,
# jangan ditempel di laptop. Override dev tanpa ubah kode:
# PURA_RESET_CODE=PURI-CONTOH-XXXX
