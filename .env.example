# Contoh konfigurasi dev — salin ke `.env` lalu sesuaikan.
# Hanya dibaca saat `npm run dev` (app production selalu pakai userData/data/pura.db).
# Path relatif dibaca dari root repo. Folder `data/` sudah di-gitignore.

PURA_DB=./data/pura-dev.db

# Seeder dev: isi DB kosong dengan 240 jurnal dummy seimbang (bukan 240
# transaksi/baris; dipakai untuk uji laporan multi-halaman).
# Hanya dibaca saat `npm run dev` + hanya jalan bila tabel jurnal masih kosong
# (tidak pernah menimpa data). Seed ulang = hapus file .db lalu restart.
PURA_SEED_DEV=false

# Kode darurat reset PIN (fitur Kunci Aplikasi) dibuat acak per-install saat
# setup PIN pertama dan hanya tampil sekali. Database hanya menyimpan hash+salt
# scrypt; tidak ada kode global/default dan tidak ada override lewat env.
# Catat kode itu di dokumen fisik bendahara, jangan ditempel di laptop atau
# dikirim lewat chat. Kode bisa diganti di Pengaturan (butuh PIN terbuka).
